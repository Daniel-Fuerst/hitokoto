# S036: the decision logic of the Debian package and the GitHub releases in
# .github/workflows/packaging.yml. Run with cmake -P; tested by tests/packaging (S036_*).
#
#   cmake -DMODE=plan -DVERSIONS_FILE=<f> -DTAGS_FILE=<f> -DRELEASES_FILE=<f> [-DDRY_RUN=ON]
#         -DOUTPUT=<f> -P DebianPackage.cmake
#       Which versions get a release. A version is every tag of the exact form vMAJOR.MINOR.PATCH in
#       TAGS_FILE (git tag --merged, one per line) from the line "first" of VERSIONS_FILE on, without
#       the versions it skips. RELEASES_FILE holds the published releases, one per line: the tag,
#       then the names of its assets, separated by spaces. Writes, one per line:
#         action=release|current|none   (versions to release | every version has its release |
#                                         no version)
#         versions=<X.Y.Z ...>          the versions without a release, oldest first
#         build=<JSON array>            the matrix: those versions, in a dry run the highest version
#         latest=<X.Y.Z>                the highest version (the release marked latest), or ""
#         skipped=<X.Y.Z ...>           skipped versions among the tags
#         without_package=<X.Y.Z ...>   published releases without the package (never changed)
#       A dry run (-DDRY_RUN=ON) fails if there is no version to build.
#   cmake -DMODE=changelog -DREPO_DIR=<git checkout> -DVERSION=<X.Y.Z> -DVERSIONS_FILE=<f>
#         -DCONTROL_FILE=<f> -DOUTPUT=<f> -DNOTES=<f> -P DebianPackage.cmake
#       The Debian changelog of VERSION (one entry per version tag from "changelog-from" on, newest
#       first; per entry the merges into main on the first-parent line since the previous version
#       tag, as "#N <title of the pull request>", and other commits there with their subject) and
#       the release notes of VERSION (its entry as Markdown). Needs git and the tag vVERSION.
#   cmake -DMODE=control -DCONTROL_FILE=<template> -DVERSION=<X.Y.Z> -DDEPENDS=<list>
#         -DINSTALLED_SIZE=<KiB> -DOUTPUT=<f> -P DebianPackage.cmake
#       The control file from the template, with @VERSION@, @DEPENDS@ and @INSTALLED_SIZE@ filled in.
#
# Semicolons and square brackets in commit messages and reasons would break CMake lists; while
# lists are built they stand as @SC@, @LB@ and @RB@. A trailing carriage return is ignored in every
# input.
cmake_minimum_required(VERSION 3.25)

set(version_regex "(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)")
set(package_revision 1)
set(changelog_width 79)

function(require)
    foreach(v IN LISTS ARGN)
        if(NOT DEFINED ${v} OR "${${v}}" STREQUAL "")
            message(FATAL_ERROR "${v} not set")
        endif()
    endforeach()
endfunction()

function(protect text out)
    string(REPLACE "\r" "" text "${text}")
    string(REPLACE ";" "@SC@" text "${text}")
    string(REPLACE "[" "@LB@" text "${text}")
    string(REPLACE "]" "@RB@" text "${text}")
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

function(unprotect text out)
    string(REPLACE "@SC@" ";" text "${text}")
    string(REPLACE "@LB@" "[" text "${text}")
    string(REPLACE "@RB@" "]" text "${text}")
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

# The lines of a text (protected), stripped, empty lines dropped.
function(text_lines text out)
    protect("${text}" text)
    string(REPLACE "\n" ";" raw "${text}")
    set(lines "")
    foreach(line IN LISTS raw)
        string(STRIP "${line}" line)
        if(NOT "${line}" STREQUAL "")
            list(APPEND lines "${line}")
        endif()
    endforeach()
    set(${out} "${lines}" PARENT_SCOPE)
endfunction()

function(read_lines file out)
    if(NOT EXISTS "${file}")
        message(FATAL_ERROR "${file} does not exist")
    endif()
    file(READ "${file}" text)
    text_lines("${text}" lines)
    set(${out} "${lines}" PARENT_SCOPE)
endfunction()

# The settings of packaging/debian/versions.txt: <prefix>_from, <prefix>_first, <prefix>_skipped
# (versions) and <prefix>_reason_<version>.
function(read_settings file prefix)
    read_lines("${file}" lines)
    set(from "")
    set(first "")
    set(skipped "")
    foreach(line IN LISTS lines)
        unprotect("${line}" shown)
        if(line MATCHES "^#")
            continue()
        elseif(line MATCHES "^changelog-from (.*)$")
            set(value "${CMAKE_MATCH_1}")
            if(NOT value MATCHES "^${version_regex}$")
                message(FATAL_ERROR "${file}: bad line '${shown}' (changelog-from MAJOR.MINOR.PATCH)")
            endif()
            set(from "${value}")
        elseif(line MATCHES "^first (.*)$")
            set(value "${CMAKE_MATCH_1}")
            if(NOT value MATCHES "^${version_regex}$")
                message(FATAL_ERROR "${file}: bad line '${shown}' (first MAJOR.MINOR.PATCH)")
            endif()
            set(first "${value}")
        elseif(line MATCHES "^skip ([^ ]+) +(.+)$")
            set(version "${CMAKE_MATCH_1}")
            set(reason "${CMAKE_MATCH_2}")
            if(NOT version MATCHES "^${version_regex}$")
                message(FATAL_ERROR "${file}: bad line '${shown}' (skip MAJOR.MINOR.PATCH <reason>)")
            endif()
            list(APPEND skipped "${version}")
            set(${prefix}_reason_${version} "${reason}" PARENT_SCOPE)
        else()
            message(FATAL_ERROR "${file}: bad line '${shown}' (changelog-from X.Y.Z, first X.Y.Z or "
                                "skip X.Y.Z <reason>)")
        endif()
    endforeach()
    if("${first}" STREQUAL "")
        message(FATAL_ERROR "${file}: no line 'first MAJOR.MINOR.PATCH'")
    endif()
    set(${prefix}_from "${from}" PARENT_SCOPE)
    set(${prefix}_first "${first}" PARENT_SCOPE)
    set(${prefix}_skipped "${skipped}" PARENT_SCOPE)
endfunction()

# The versions of the tags of the exact form vMAJOR.MINOR.PATCH, unique, in ascending order.
function(tag_versions tags out)
    set(versions "")
    foreach(tag IN LISTS tags)
        if(tag MATCHES "^v${version_regex}$")
            string(SUBSTRING "${tag}" 1 -1 version)
            list(APPEND versions "${version}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES versions)
    list(SORT versions COMPARE NATURAL)
    set(${out} "${versions}" PARENT_SCOPE)
endfunction()

function(package_file version out)
    set(${out} "hitokoto_${version}-${package_revision}_amd64.deb" PARENT_SCOPE)
endfunction()

function(json_array out)
    set(items "")
    foreach(item IN LISTS ARGN)
        list(APPEND items "\"${item}\"")
    endforeach()
    list(JOIN items "," joined)
    set(${out} "[${joined}]" PARENT_SCOPE)
endfunction()

function(plan)
    require(VERSIONS_FILE TAGS_FILE RELEASES_FILE OUTPUT)
    read_settings("${VERSIONS_FILE}" setting)
    read_lines("${TAGS_FILE}" tags)
    tag_versions("${tags}" all)

    set(eligible "")
    set(skipped "")
    foreach(version IN LISTS all)
        if(version VERSION_LESS setting_first)
            continue()
        endif()
        if(version IN_LIST setting_skipped)
            list(APPEND skipped "${version}")
            unprotect("${setting_reason_${version}}" reason)
            message(STATUS "${version} is skipped: ${reason}")
            continue()
        endif()
        list(APPEND eligible "${version}")
    endforeach()

    # Published releases and whether they carry the package.
    read_lines("${RELEASES_FILE}" releases)
    set(published "")
    foreach(line IN LISTS releases)
        string(REGEX REPLACE " +" ";" fields "${line}")
        list(POP_FRONT fields tag)
        if(NOT tag MATCHES "^v${version_regex}$")
            continue()
        endif()
        string(SUBSTRING "${tag}" 1 -1 version)
        list(APPEND published "${version}")
        package_file("${version}" deb)
        if(deb IN_LIST fields)
            set(has_package_${version} TRUE)
        endif()
    endforeach()

    set(to_release "")
    set(without_package "")
    foreach(version IN LISTS eligible)
        if(NOT version IN_LIST published)
            list(APPEND to_release "${version}")
        elseif(NOT has_package_${version})
            package_file("${version}" deb)
            message(WARNING "the release v${version} has no ${deb}; a published release is never "
                            "changed")
            list(APPEND without_package "${version}")
        endif()
    endforeach()

    set(latest "")
    if(eligible)
        list(GET eligible -1 latest)
    endif()
    if(NOT eligible)
        set(action none)
    elseif(to_release)
        set(action release)
    else()
        set(action current)
    endif()

    if(DRY_RUN)
        if("${latest}" STREQUAL "")
            message(FATAL_ERROR "no version tag from ${setting_first} on; nothing to build")
        endif()
        json_array(build "${latest}")
    else()
        json_array(build ${to_release})
    endif()

    list(JOIN to_release " " versions_text)
    list(JOIN skipped " " skipped_text)
    list(JOIN without_package " " without_text)
    file(WRITE "${OUTPUT}" "action=${action}\nversions=${versions_text}\nbuild=${build}\n"
                           "latest=${latest}\nskipped=${skipped_text}\n"
                           "without_package=${without_text}\n")
endfunction()

# ---- changelog ----

function(git_output out)
    execute_process(COMMAND "${git_executable}" -C "${REPO_DIR}" ${ARGN}
        RESULT_VARIABLE code OUTPUT_VARIABLE text ERROR_VARIABLE err)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "git ${ARGN}: ${err}")
    endif()
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

# The length of a protected text as it will be written.
function(shown_length text out)
    string(REGEX REPLACE "@(SC|LB|RB)@" "x" text "${text}")
    string(LENGTH "${text}" n)
    set(${out} ${n} PARENT_SCOPE)
endfunction()

# A changelog item: "  * " and the words, wrapped at changelog_width with an indent of four.
function(wrap_item text out)
    string(REGEX REPLACE " +" ";" words "${text}")
    set(result "  *")
    set(line "  *")
    foreach(word IN LISTS words)
        shown_length("${line} ${word}" n)
        if(n GREATER changelog_width AND NOT "${line}" STREQUAL "  *" AND NOT "${line}" STREQUAL "   ")
            string(APPEND result "\n    ${word}")
            set(line "    ${word}")
        else()
            string(APPEND result " ${word}")
            string(APPEND line " ${word}")
        endif()
    endforeach()
    set(${out} "${result}" PARENT_SCOPE)
endfunction()

# The items of the version tag <current> since the version tag <previous> (protected, one per list
# entry): merges of pull requests as "#N <title>", other commits with their subject.
function(version_items previous current out)
    git_output(hashes log --first-parent --reverse --format=%H "v${previous}..v${current}")
    text_lines("${hashes}" hashes)
    set(items "")
    foreach(hash IN LISTS hashes)
        git_output(parents show -s --format=%P "${hash}")
        string(STRIP "${parents}" parents)
        string(REPLACE " " ";" parents "${parents}")
        list(LENGTH parents n)
        git_output(subject show -s --format=%s "${hash}")
        protect("${subject}" subject)
        string(STRIP "${subject}" subject)
        if(n GREATER 1 AND subject MATCHES "^Merge pull request #([0-9]+) from ")
            set(number "${CMAKE_MATCH_1}")
            git_output(body show -s --format=%b "${hash}")
            text_lines("${body}" body_lines)
            list(LENGTH body_lines body_count)
            if(body_count GREATER 0)
                list(GET body_lines 0 title)
            else()
                string(REGEX REPLACE "^Merge pull request #[0-9]+ from " "" title "${subject}")
            endif()
            list(APPEND items "#${number} ${title}")
        else()
            list(APPEND items "${subject}")
        endif()
    endforeach()
    list(LENGTH items count)
    if(count EQUAL 0)
        set(items "No changes listed.")
    endif()
    set(${out} "${items}" PARENT_SCOPE)
endfunction()

function(changelog)
    require(REPO_DIR VERSION VERSIONS_FILE CONTROL_FILE OUTPUT NOTES)
    if(NOT VERSION MATCHES "^${version_regex}$")
        message(FATAL_ERROR "VERSION='${VERSION}' is not MAJOR.MINOR.PATCH")
    endif()
    find_package(Git QUIET)
    if(NOT GIT_FOUND)
        message(FATAL_ERROR "git not found; the changelog is generated from the history")
    endif()
    set(git_executable "${GIT_EXECUTABLE}")
    read_settings("${VERSIONS_FILE}" setting)
    if("${setting_from}" STREQUAL "")
        message(FATAL_ERROR "${VERSIONS_FILE}: no line 'changelog-from MAJOR.MINOR.PATCH'")
    endif()

    execute_process(COMMAND "${git_executable}" -C "${REPO_DIR}" rev-parse --verify --quiet
            "refs/tags/v${VERSION}"
        RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "the tag v${VERSION} does not exist in ${REPO_DIR}")
    endif()

    file(STRINGS "${CONTROL_FILE}" maintainer REGEX "^Maintainer: " ENCODING UTF-8)
    string(REGEX REPLACE "^Maintainer: " "" maintainer "${maintainer}")
    string(STRIP "${maintainer}" maintainer)
    if("${maintainer}" STREQUAL "")
        message(FATAL_ERROR "${CONTROL_FILE} has no Maintainer")
    endif()

    git_output(tags_text tag --merged "v${VERSION}")
    text_lines("${tags_text}" tags)
    tag_versions("${tags}" all)
    set(versions "")
    foreach(version IN LISTS all)
        if(NOT version VERSION_LESS setting_from AND NOT version VERSION_GREATER VERSION)
            list(APPEND versions "${version}")
        endif()
    endforeach()

    # Protected like every item (its semicolon would split the list).
    set(first_text "First version with a version tag@SC@ earlier changes are not listed.")
    set(entries "")
    set(previous "")
    set(notes_items "")
    foreach(version IN LISTS versions)
        if("${previous}" STREQUAL "")
            set(items "${first_text}")
        else()
            version_items("${previous}" "${version}" items)
        endif()
        git_output(date log -1 --format=%cD "v${version}")
        string(STRIP "${date}" date)
        set(entry "hitokoto (${version}-${package_revision}) trixie@SC@ urgency=medium\n\n")
        foreach(item IN LISTS items)
            wrap_item("${item}" wrapped)
            string(APPEND entry "${wrapped}\n")
        endforeach()
        string(APPEND entry "\n -- ${maintainer}  ${date}\n")
        # Newest first.
        set(entries "${entry}\n${entries}")
        if(version STREQUAL VERSION)
            set(notes_previous "${previous}")
            set(notes_items "${items}")
        endif()
        set(previous "${version}")
    endforeach()
    string(REGEX REPLACE "\n+$" "\n" entries "${entries}")
    unprotect("${entries}" entries)
    file(WRITE "${OUTPUT}" "${entries}")

    package_file("${VERSION}" deb)
    if("${notes_previous}" STREQUAL "")
        set(notes "${first_text}\n\n")
    else()
        set(notes "Changes since v${notes_previous}:\n\n")
        foreach(item IN LISTS notes_items)
            string(APPEND notes "- ${item}\n")
        endforeach()
        string(APPEND notes "\n")
    endif()
    string(APPEND notes "Debian package for trixie (amd64): `${deb}`, checksum in `SHA256SUMS`.\n")
    unprotect("${notes}" notes)
    file(WRITE "${NOTES}" "${notes}")
endfunction()

# ---- control ----

function(control)
    require(CONTROL_FILE VERSION DEPENDS INSTALLED_SIZE OUTPUT)
    if(NOT VERSION MATCHES "^${version_regex}$")
        message(FATAL_ERROR "VERSION='${VERSION}' is not MAJOR.MINOR.PATCH")
    endif()
    if(NOT INSTALLED_SIZE MATCHES "^[0-9]+$")
        message(FATAL_ERROR "INSTALLED_SIZE='${INSTALLED_SIZE}' is not a number of KiB")
    endif()
    if(NOT EXISTS "${CONTROL_FILE}")
        message(FATAL_ERROR "${CONTROL_FILE} does not exist")
    endif()
    file(READ "${CONTROL_FILE}" text)
    string(REPLACE "\r" "" text "${text}")
    string(REPLACE "@VERSION@" "${VERSION}" text "${text}")
    string(REPLACE "@DEPENDS@" "${DEPENDS}" text "${text}")
    string(REPLACE "@INSTALLED_SIZE@" "${INSTALLED_SIZE}" text "${text}")
    string(REGEX MATCH "@[A-Z_]+@" left "${text}")
    if(NOT "${left}" STREQUAL "")
        message(FATAL_ERROR "${CONTROL_FILE}: unknown placeholder ${left}")
    endif()
    foreach(field IN ITEMS Package Version Architecture Maintainer Description)
        string(FIND "\n${text}" "\n${field}: " at)
        if(at EQUAL -1)
            message(FATAL_ERROR "${CONTROL_FILE}: no field ${field}")
        endif()
    endforeach()
    if(NOT text MATCHES "\n$")
        string(APPEND text "\n")
    endif()
    file(WRITE "${OUTPUT}" "${text}")
endfunction()

if(NOT DEFINED MODE)
    message(FATAL_ERROR "MODE not set (plan, changelog or control)")
elseif(MODE STREQUAL "plan")
    plan()
elseif(MODE STREQUAL "changelog")
    changelog()
elseif(MODE STREQUAL "control")
    control()
else()
    message(FATAL_ERROR "unknown MODE '${MODE}'")
endif()
