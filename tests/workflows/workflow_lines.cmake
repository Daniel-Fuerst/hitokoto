# Helpers of the workflow lints (S035, S036): the workflow files are read as text, without a YAML
# parser. Included by the case files; they set WORKFLOWS_DIR.

function(expect_eq actual expected what)
    if(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "${what}: '${actual}', expected '${expected}'")
    endif()
endfunction()

# The lines of a workflow file as a CMake list, carriage returns removed. Semicolons and square
# brackets would break CMake lists, so they are stored as @SC@, @LB@ and @RB@.
function(read_workflow name out)
    set(file "${WORKFLOWS_DIR}/${name}")
    if(NOT EXISTS "${file}")
        message(FATAL_ERROR "${file} does not exist")
    endif()
    file(READ "${file}" text)
    string(REPLACE "\r" "" text "${text}")
    string(REPLACE ";" "@SC@" text "${text}")
    string(REPLACE "[" "@LB@" text "${text}")
    string(REPLACE "]" "@RB@" text "${text}")
    string(REPLACE "\n" ";" text "${text}")
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

# The lines of the top-level section <key>: (up to the next top-level key), without the key line.
function(section lines key out)
    set(in FALSE)
    set(result "")
    foreach(line IN LISTS lines)
        if(line MATCHES "^[A-Za-z_-]+:")
            if(line MATCHES "^${key}:")
                set(in TRUE)
                continue()
            elseif(in)
                break()
            endif()
        endif()
        if(in)
            list(APPEND result "${line}")
        endif()
    endforeach()
    set(${out} "${result}" PARENT_SCOPE)
endfunction()

# The ids of the jobs (two-space keys under jobs:) and, per job, its lines as <prefix>_<id>.
function(jobs lines prefix)
    section("${lines}" jobs body)
    set(ids "")
    set(current "")
    foreach(line IN LISTS body)
        if(line MATCHES "^  ([A-Za-z0-9_-]+):[ ]*$")
            set(current "${CMAKE_MATCH_1}")
            list(APPEND ids "${current}")
            set(${prefix}_${current} "")
        elseif(NOT "${current}" STREQUAL "")
            list(APPEND ${prefix}_${current} "${line}")
        endif()
    endforeach()
    set(${prefix}_ids "${ids}" PARENT_SCOPE)
    foreach(id IN LISTS ids)
        set(${prefix}_${id} "${${prefix}_${id}}" PARENT_SCOPE)
    endforeach()
endfunction()

# The value of a four-space key of a job (the first line only), or "".
function(job_value job_lines key out)
    set(value "")
    foreach(line IN LISTS job_lines)
        if(line MATCHES "^    ${key}:[ ]*(.*)$")
            set(value "${CMAKE_MATCH_1}")
            break()
        endif()
    endforeach()
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

# The if: condition of a job, its continuation lines joined with spaces, or "".
function(job_condition job_lines out)
    set(condition "")
    set(in_if FALSE)
    foreach(line IN LISTS job_lines)
        if(line MATCHES "^    if:(.*)$")
            set(in_if TRUE)
            string(APPEND condition "${CMAKE_MATCH_1}")
        elseif(in_if AND line MATCHES "^      (.*)$")
            string(APPEND condition " ${CMAKE_MATCH_1}")
        else()
            set(in_if FALSE)
        endif()
    endforeach()
    string(STRIP "${condition}" condition)
    set(${out} "${condition}" PARENT_SCOPE)
endfunction()
