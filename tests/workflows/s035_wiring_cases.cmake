# S035: lints over the workflow files: a version tag only after a green CI on main, and "Packaging"
# right behind the CI. Run with cmake -P; the files are read as text (no YAML parser).
#   -DCASE=<name>            the case below
#   -DWORKFLOWS_DIR=<dir>    .github/workflows
cmake_minimum_required(VERSION 3.25)

foreach(v IN ITEMS CASE WORKFLOWS_DIR)
    if(NOT DEFINED ${v} OR "${${v}}" STREQUAL "")
        message(FATAL_ERROR "${v} not set")
    endif()
endforeach()

function(expect_eq actual expected what)
    if(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "${what}: '${actual}', expected '${expected}'")
    endif()
endfunction()

# The lines of a workflow file as a CMake list, carriage returns removed. Semicolons and square
# brackets would break CMake lists, so they are stored as @SC@, @LB@ and @RB@.
function(read_workflow name out)
    set(file "${WORKFLOWS_DIR}/${name}")
    if(NOT EXISTS "${file}")
        message(FATAL_ERROR "${file} does not exist")
    endif()
    file(READ "${file}" text)
    string(REPLACE "\r" "" text "${text}")
    string(REPLACE ";" "@SC@" text "${text}")
    string(REPLACE "[" "@LB@" text "${text}")
    string(REPLACE "]" "@RB@" text "${text}")
    string(REPLACE "\n" ";" text "${text}")
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

# The lines of the top-level section <key>: (up to the next top-level key), without the key line.
function(section lines key out)
    set(in FALSE)
    set(result "")
    foreach(line IN LISTS lines)
        if(line MATCHES "^[A-Za-z_-]+:")
            if(line MATCHES "^${key}:")
                set(in TRUE)
                continue()
            elseif(in)
                break()
            endif()
        endif()
        if(in)
            list(APPEND result "${line}")
        endif()
    endforeach()
    set(${out} "${result}" PARENT_SCOPE)
endfunction()

# The ids of the jobs (two-space keys under jobs:) and, per job, its lines as <prefix>_<id>.
function(jobs lines prefix)
    section("${lines}" jobs body)
    set(ids "")
    set(current "")
    foreach(line IN LISTS body)
        if(line MATCHES "^  ([A-Za-z0-9_-]+):[ ]*$")
            set(current "${CMAKE_MATCH_1}")
            list(APPEND ids "${current}")
            set(${prefix}_${current} "")
        elseif(NOT "${current}" STREQUAL "")
            list(APPEND ${prefix}_${current} "${line}")
        endif()
    endforeach()
    set(${prefix}_ids "${ids}" PARENT_SCOPE)
    foreach(id IN LISTS ids)
        set(${prefix}_${id} "${${prefix}_${id}}" PARENT_SCOPE)
    endforeach()
endfunction()

# The value of a four-space key of a job (the first line only), or "".
function(job_value job_lines key out)
    set(value "")
    foreach(line IN LISTS job_lines)
        if(line MATCHES "^    ${key}:[ ]*(.*)$")
            set(value "${CMAKE_MATCH_1}")
            break()
        endif()
    endforeach()
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

if("${CASE}" STREQUAL "TheVersionJobNeedsEveryCiJob")
    read_workflow(ci.yml ci)
    jobs("${ci}" job)
    if(NOT "version" IN_LIST job_ids)
        message(FATAL_ERROR "ci.yml has no job 'version' (S035, decision 1)")
    endif()
    job_value("${job_version}" uses uses)
    expect_eq("${uses}" "./.github/workflows/version.yml" "uses of the job version")
    job_value("${job_version}" needs needs)
    if(NOT needs MATCHES "^@LB@(.*)@RB@$")
        message(FATAL_ERROR "needs of the job version is not a list in brackets: '${needs}'")
    endif()
    string(REPLACE "," ";" needed "${CMAKE_MATCH_1}")
    list(TRANSFORM needed STRIP)
    list(SORT needed)
    set(others ${job_ids})
    list(REMOVE_ITEM others version)
    list(SORT others)
    expect_eq("${needed}" "${others}" "needs of the job version (every other job of the CI)")
    # Review O1: a skipped job must not stop the version; a failed or cancelled one must.
    set(condition "")
    set(in_if FALSE)
    foreach(line IN LISTS job_version)
        if(line MATCHES "^    if:(.*)$")
            set(in_if TRUE)
            string(APPEND condition "${CMAKE_MATCH_1}")
        elseif(in_if AND line MATCHES "^      (.*)$")
            string(APPEND condition " ${CMAKE_MATCH_1}")
        else()
            set(in_if FALSE)
        endif()
    endforeach()
    foreach(part IN ITEMS "always()" "!contains(needs.*.result, 'failure')"
                          "!contains(needs.*.result, 'cancelled')" "github.event_name == 'push'"
                          "github.ref == 'refs/heads/main'")
        string(FIND "${condition}" "${part}" at)
        if(at EQUAL -1)
            message(FATAL_ERROR "the condition of the job version lacks ${part}: '${condition}'")
        endif()
    endforeach()

elseif("${CASE}" STREQUAL "CiRunsOnMainAreNotCancelled")
    read_workflow(ci.yml ci)
    section("${ci}" concurrency body)
    list(JOIN body "\n" text)
    if(NOT text MATCHES "cancel-in-progress: \\$\\{\\{ github.event_name == 'pull_request' \\}\\}")
        message(FATAL_ERROR "ci.yml cancels runs other than those of pull requests:\n${text}")
    endif()
    if(NOT text MATCHES "group: ci-\\$\\{\\{ github.event_name == 'pull_request' && github.ref \\|\\| github.sha \\}\\}")
        message(FATAL_ERROR "ci.yml does not give every push its own concurrency group:\n${text}")
    endif()

elseif("${CASE}" STREQUAL "VersionHasNoTriggerOfItsOwnOnMain")
    read_workflow(version.yml version)
    section("${version}" on triggers)
    set(found "")
    foreach(line IN LISTS triggers)
        if(line MATCHES "^  ([a-z_]+):")
            list(APPEND found "${CMAKE_MATCH_1}")
        endif()
    endforeach()
    list(SORT found)
    expect_eq("${found}" "pull_request;workflow_call" "triggers of version.yml")
    jobs("${version}" job)
    job_value("${job_tag}" if condition)
    expect_eq("${condition}" "github.event_name != 'pull_request'" "condition of the tag job")
    # The tag job tags up to the commit of the CI run that called it (github.sha), never main.
    list(JOIN job_tag "\n" text)
    if(NOT text MATCHES "\n          ref: \\$\\{\\{ github.sha \\}\\}\n")
        message(FATAL_ERROR "the tag job does not check out github.sha")
    endif()

elseif("${CASE}" STREQUAL "PackagingFollowsTheCi")
    read_workflow(packaging.yml packaging)
    section("${packaging}" on triggers)
    list(JOIN triggers "\n" text)
    if(NOT text MATCHES "\n  workflow_run:\n    workflows: @LB@\"CI\"@RB@\n")
        message(FATAL_ERROR "packaging.yml does not follow the workflow CI:\n${text}")
    endif()
    jobs("${packaging}" job)
    list(JOIN job_build "\n" build)
    if(NOT build MATCHES "ref: \\$\\{\\{ github.event.workflow_run.head_sha \\}\\}")
        message(FATAL_ERROR "the build job of packaging.yml does not check out the CI's commit")
    endif()
    if(NOT build MATCHES "github.event.workflow_run.event == 'push'")
        message(FATAL_ERROR "the build job of packaging.yml does not require a CI run on a push")
    endif()

else()
    message(FATAL_ERROR "unknown case '${CASE}'")
endif()
