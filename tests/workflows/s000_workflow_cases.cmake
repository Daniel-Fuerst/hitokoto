# S000: lints over every workflow file: actions come from a fixed commit, and the token of a job
# has only the rights the job asks for. Run with cmake -P; the files are read as text (no YAML
# parser).
#   -DCASE=<name>            the case below
#   -DWORKFLOWS_DIR=<dir>    .github/workflows
#   -DSOURCE_DIR=<dir>       the source tree (fuzz/CMakeLists.txt)
cmake_minimum_required(VERSION 3.25)

foreach(v IN ITEMS CASE WORKFLOWS_DIR SOURCE_DIR)
    if(NOT DEFINED ${v} OR "${${v}}" STREQUAL "")
        message(FATAL_ERROR "${v} not set")
    endif()
endforeach()

include("${CMAKE_CURRENT_LIST_DIR}/workflow_lines.cmake")

# The workflow files, by name.
file(GLOB workflow_paths "${WORKFLOWS_DIR}/*.yml")
set(workflows "")
foreach(path IN LISTS workflow_paths)
    get_filename_component(name "${path}" NAME)
    list(APPEND workflows "${name}")
endforeach()
list(SORT workflows)
if(NOT workflows)
    message(FATAL_ERROR "no workflow in ${WORKFLOWS_DIR}")
endif()

# The steps of a job that use <action> (owner/repo): each step's lines as one string joined with
# newlines, in <out>.
function(steps_using job_lines action out)
    set(result "")
    set(current "")
    set(in FALSE)
    foreach(line IN LISTS job_lines)
        if(line MATCHES "^      - ")
            if(in)
                list(APPEND result "${current}")
            endif()
            set(current "${line}")
            string(FIND "${line}" "${action}@" at)
            set(in FALSE)
            if(NOT at EQUAL -1)
                set(in TRUE)
            endif()
        elseif(line MATCHES "^       ")
            string(APPEND current "\n${line}")
            string(FIND "${line}" "uses: ${action}@" at)
            if(NOT at EQUAL -1)
                set(in TRUE)
            endif()
        else()
            if(in)
                list(APPEND result "${current}")
            endif()
            set(in FALSE)
            set(current "")
        endif()
    endforeach()
    if(in)
        list(APPEND result "${current}")
    endif()
    set(${out} "${result}" PARENT_SCOPE)
endfunction()

if("${CASE}" STREQUAL "EveryActionIsPinnedToACommit")
    # A tag or branch of an action can be moved by whoever controls its repository; a commit cannot.
    # The version the commit carries stands in a comment, for people and for updates.
    set(count 0)
    foreach(name IN LISTS workflows)
        read_workflow("${name}" lines)
        set(number 0)
        foreach(line IN LISTS lines)
            math(EXPR number "${number} + 1")
            if(NOT line MATCHES "^[ ]*(- )?uses:[ ]*([^ #]+)[ ]*(#.*)?$")
                continue()
            endif()
            set(ref "${CMAKE_MATCH_2}")
            set(comment "${CMAKE_MATCH_3}")
            math(EXPR count "${count} + 1")
            if(ref MATCHES "^\\./")
                continue()  # a workflow or an action of this repository
            endif()
            if(NOT ref MATCHES "^[A-Za-z0-9_.-]+/[A-Za-z0-9_./-]+@[0-9a-f]+$")
                message(FATAL_ERROR "${name}:${number}: '${ref}' is not owner/repo@commit")
            endif()
            string(REGEX REPLACE "^.*@" "" sha "${ref}")
            string(LENGTH "${sha}" length)
            if(NOT length EQUAL 40)
                message(FATAL_ERROR "${name}:${number}: '${ref}' does not name a full commit (40 hex digits)")
            endif()
            if(NOT comment MATCHES "^# v[0-9]+\\.[0-9]+\\.[0-9]+$")
                message(FATAL_ERROR "${name}:${number}: '${ref}' has no comment '# vMAJOR.MINOR.PATCH' with its version")
            endif()
        endforeach()
    endforeach()
    if(count EQUAL 0)
        message(FATAL_ERROR "no 'uses:' in any workflow: the lint reads nothing")
    endif()

elseif("${CASE}" STREQUAL "AqtinstallIsPinnedToOneVersion")
    # install-qt-action installs aqtinstall with pip; without a version of its own it takes the
    # newest of a series. Each call names one release (on Windows aqtsource, a fixed commit, wins).
    set(count 0)
    foreach(name IN LISTS workflows)
        read_workflow("${name}" lines)
        jobs("${lines}" job)
        foreach(id IN LISTS job_ids)
            steps_using("${job_${id}}" jurplel/install-qt-action steps)
            foreach(step IN LISTS steps)
                math(EXPR count "${count} + 1")
                if(NOT step MATCHES "\n[ ]+aqtversion:[ ]*\"?==[0-9]+\\.[0-9]+\\.[0-9]+\"?[ ]*(\n|$)")
                    message(FATAL_ERROR "${name}, job ${id}: install-qt-action without 'aqtversion: ==X.Y.Z':\n${step}")
                endif()
            endforeach()
        endforeach()
    endforeach()
    if(count EQUAL 0)
        message(FATAL_ERROR "no call of install-qt-action found: the lint reads nothing")
    endif()

elseif("${CASE}" STREQUAL "EveryWorkflowStartsWithoutPermissions")
    # The token of a job has no right the job does not ask for, whatever the repository's default.
    foreach(name IN LISTS workflows)
        read_workflow("${name}" lines)
        set(seen_permissions FALSE)
        foreach(line IN LISTS lines)
            if(line MATCHES "^permissions:(.*)$")
                string(STRIP "${CMAKE_MATCH_1}" value)
                expect_eq("${value}" "{}" "${name}: top-level permissions")
                set(seen_permissions TRUE)
            elseif(line MATCHES "^jobs:")
                break()
            endif()
        endforeach()
        if(NOT seen_permissions)
            message(FATAL_ERROR "${name} does not set 'permissions: {}' before its jobs")
        endif()
    endforeach()

elseif("${CASE}" STREQUAL "EveryCiJobAsksForItsPermissions")
    read_workflow(ci.yml ci)
    jobs("${ci}" job)
    foreach(id IN LISTS job_ids)
        set(found FALSE)
        foreach(line IN LISTS job_${id})
            if(line MATCHES "^    permissions:")
                set(found TRUE)
                break()
            endif()
        endforeach()
        if(NOT found)
            message(FATAL_ERROR "ci.yml: the job ${id} does not set its permissions")
        endif()
    endforeach()

elseif("${CASE}" STREQUAL "OnlyTheStepThatCallsGhHasTheToken")
    # A token in the env of a job reaches every step, actions and the code under test included.
    foreach(name IN LISTS workflows)
        read_workflow("${name}" lines)
        jobs("${lines}" job)
        foreach(id IN LISTS job_ids)
            set(in_job_env FALSE)
            foreach(line IN LISTS job_${id})
                if(line MATCHES "^    env:")
                    set(in_job_env TRUE)
                elseif(line MATCHES "^    [A-Za-z_-]+:")
                    set(in_job_env FALSE)
                elseif(in_job_env AND line MATCHES "\\$\\{\\{ *(github\\.token|secrets\\.)")
                    message(FATAL_ERROR "${name}: the job ${id} gives a token to all its steps: '${line}'")
                endif()
            endforeach()
        endforeach()
    endforeach()

else()
    message(FATAL_ERROR "unknown case ${CASE}")
endif()
