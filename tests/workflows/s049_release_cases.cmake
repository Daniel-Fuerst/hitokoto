# S049: lints over packaging.yml for the macOS disk image: the macOS jobs build and check the
# versions of the plan without writing, only a checked DMG reaches the release job, and the release
# job waits for it beside the Debian package and the MSI. Run with cmake -P; the file is read as
# text (no YAML parser).
#   -DCASE=<name>            the case below
#   -DWORKFLOWS_DIR=<dir>    .github/workflows
cmake_minimum_required(VERSION 3.25)

foreach(v IN ITEMS CASE WORKFLOWS_DIR)
    if(NOT DEFINED ${v} OR "${${v}}" STREQUAL "")
        message(FATAL_ERROR "${v} not set")
    endif()
endforeach()

include("${CMAKE_CURRENT_LIST_DIR}/workflow_lines.cmake")

set(macos_jobs macos-package macos-check)

read_workflow(packaging.yml packaging)
jobs("${packaging}" job)
foreach(id IN LISTS macos_jobs ITEMS macos-handover debian-plan debian-release)
    if(NOT id IN_LIST job_ids)
        message(FATAL_ERROR "packaging.yml has no job '${id}' (jobs: ${job_ids})")
    endif()
endforeach()

if("${CASE}" STREQUAL "TheMacosJobsOnlyRead")
    # Decision 8 (S036 decision 8): the release job stays the only one that writes.
    foreach(id IN LISTS macos_jobs)
        list(JOIN job_${id} "\n" text)
        if(NOT text MATCHES "\n    permissions:\n      contents: read\n    [a-z]")
            message(FATAL_ERROR "the job ${id} does not have exactly contents: read")
        endif()
        if(text MATCHES "secrets\\.")
            message(FATAL_ERROR "the job ${id} uses a secret")
        endif()
    endforeach()
    list(JOIN job_macos-handover "\n" handover)
    if(NOT handover MATCHES "\n    permissions: {}\n")
        message(FATAL_ERROR "macos-handover has permissions")
    endif()

elseif("${CASE}" STREQUAL "TheMacosJobsRunOnTheCiImage")
    # Decisions 4 and 7: the image of the macOS CI (Apple silicon).
    read_workflow(ci.yml ci)
    set(ci_os "")
    foreach(line IN LISTS ci)
        if(line MATCHES "^ *- { name: macOS, os: ([a-z0-9.-]+),")
            set(ci_os "${CMAKE_MATCH_1}")
        endif()
    endforeach()
    if("${ci_os}" STREQUAL "")
        message(FATAL_ERROR "ci.yml has no row for macOS")
    endif()
    foreach(id IN LISTS macos_jobs)
        job_value("${job_${id}}" runs-on runs_on)
        expect_eq("${runs_on}" "${ci_os}" "runs-on of ${id} against the macOS CI")
    endforeach()

elseif("${CASE}" STREQUAL "OneMacosVersionDoesNotStopTheOthers")
    # Decision 2: a matrix entry per version without fail-fast, from the plan.
    foreach(id IN LISTS macos_jobs)
        list(JOIN job_${id} "\n" text)
        if(NOT text MATCHES "\n      fail-fast: false\n")
            message(FATAL_ERROR "the matrix of ${id} can fail fast")
        endif()
        if(NOT text MATCHES "version: \\$\\{\\{ fromJSON\\(needs.debian-plan.outputs.macos_build\\) \\}\\}")
            message(FATAL_ERROR "the matrix of ${id} does not come from the macOS plan")
        endif()
    endforeach()
    job_value("${job_macos-check}" needs needs)
    if(NOT needs MATCHES "macos-package")
        message(FATAL_ERROR "macos-check does not need macos-package: '${needs}'")
    endif()
    # A failed build of one version does not skip the checks of the others.
    job_condition("${job_macos-check}" condition)
    foreach(part IN ITEMS "!cancelled()" "needs.debian-plan.result == 'success'")
        string(FIND "${condition}" "${part}" at)
        if(at EQUAL -1)
            message(FATAL_ERROR "the condition of macos-check lacks ${part}: '${condition}'")
        endif()
    endforeach()

elseif("${CASE}" STREQUAL "OnlyACheckedDiskImageIsReleased")
    # Decision 7: the build job hands its DMG to the check job only; the check job hands it on,
    # unzipped, after the check passed.
    list(JOIN job_macos-package "\n" package)
    if(package MATCHES "archive: false")
        message(FATAL_ERROR "macos-package hands on an artifact the release job takes")
    endif()
    if(NOT package MATCHES "name: dmg-build-\\$\\{\\{ matrix.version \\}\\}")
        message(FATAL_ERROR "macos-package does not hand on dmg-build-<version>")
    endif()
    list(JOIN job_macos-check "\n" check)
    if(NOT check MATCHES "name: dmg-build-\\$\\{\\{ matrix.version \\}\\}")
        message(FATAL_ERROR "macos-check does not take dmg-build-<version>")
    endif()
    if(NOT check MATCHES "\n          archive: false\n          path: [^\n]*/hitokoto-\\$\\{\\{ matrix.version \\}\\}-arm64.dmg\n")
        message(FATAL_ERROR "macos-check does not hand on exactly the DMG of the version, unzipped")
    endif()
    string(FIND "${check}" "uses: actions/upload-artifact" upload)
    string(FIND "${check}" "install-check.sh" install)
    if(upload EQUAL -1 OR install EQUAL -1 OR upload LESS install)
        message(FATAL_ERROR "macos-check hands the DMG on before it is checked")
    endif()

elseif("${CASE}" STREQUAL "TheReleaseWaitsForTheDiskImage")
    # Decisions 2 and 8: the release job needs the macOS check, takes the checked DMGs into the
    # same flat directory as the other packages, may find none, and releases a version only with
    # every package it needs.
    job_value("${job_debian-release}" needs needs)
    foreach(other IN ITEMS debian-plan debian-package windows-check macos-check)
        if(NOT needs MATCHES "(^|[^a-z-])${other}([^a-z-]|$)")
            message(FATAL_ERROR "debian-release does not need ${other}: '${needs}'")
        endif()
    endforeach()
    list(JOIN job_debian-release "\n" release)
    if(NOT release MATCHES "\n      - uses: actions/download-artifact@[0-9a-f]+ # v8\\.[0-9.]+\n        if: [^\n]*\n        continue-on-error: true\n        with:\n          pattern: hitokoto-\\*-arm64.dmg\n          merge-multiple: true\n          path: \\$\\{\\{ runner.temp \\}\\}/debian\n")
        message(FATAL_ERROR "debian-release does not take the DMGs into the directory of the packages, or stops without them")
    endif()
    if(NOT release MATCHES "MACOS_SKIPPED: \\$\\{\\{ needs.debian-plan.outputs.macos_skipped \\}\\}")
        message(FATAL_ERROR "debian-release does not know the versions skipped for macOS")
    endif()
    if(NOT release MATCHES "dmg=\"hitokoto-\\$\\{version\\}-arm64.dmg\"")
        message(FATAL_ERROR "debian-release does not look for hitokoto-<version>-arm64.dmg")
    endif()
    if(NOT release MATCHES "packages\\+=\\(\"\\$dmg\"\\)")
        message(FATAL_ERROR "debian-release does not upload the DMG")
    endif()
    job_condition("${job_debian-release}" condition)
    if(condition MATCHES "needs.macos-")
        message(FATAL_ERROR "debian-release waits for every version of macOS: '${condition}'")
    endif()

elseif("${CASE}" STREQUAL "TheMacosRecipeStartsADryRun")
    # Decision 10: a pull request that changes the macOS recipe runs the dry run.
    section("${packaging}" on on_lines)
    list(JOIN on_lines "\n" on_text)
    if(NOT on_text MATCHES "\n      - packaging/macos/\\*\\*\n")
        message(FATAL_ERROR "a pull request that changes packaging/macos starts no dry run")
    endif()

elseif("${CASE}" STREQUAL "TheHandOverOfTheDiskImageIsCheckedInADryRun")
    # The release job runs only on main; macos-handover downloads the checked DMGs exactly as the
    # release job does, also in a dry run, and checks that each one arrives as a disk image.
    job_value("${job_macos-handover}" needs needs)
    if(NOT needs MATCHES "macos-check")
        message(FATAL_ERROR "macos-handover does not need macos-check: '${needs}'")
    endif()
    job_condition("${job_macos-handover}" condition)
    if(condition MATCHES "refs/heads/main" OR condition MATCHES "inputs.publish")
        message(FATAL_ERROR "macos-handover does not run in a dry run: '${condition}'")
    endif()
    list(JOIN job_macos-handover "\n" handover)
    if(NOT handover MATCHES "\n          pattern: hitokoto-\\*-arm64.dmg\n          merge-multiple: true\n          path: \\$\\{\\{ runner.temp \\}\\}/debian\n")
        message(FATAL_ERROR "macos-handover does not download like the release job")
    endif()
    if(NOT handover MATCHES "hitokoto-\\$\\{version\\}-arm64.dmg" OR NOT handover MATCHES "koly")
        message(FATAL_ERROR "macos-handover does not check each hitokoto-<version>-arm64.dmg as a disk image")
    endif()

elseif("${CASE}" STREQUAL "TheMacosJobsTakeTheToolsOfThePlan")
    # Decision 3: Qt, its arch and the oldest macOS come from the recipe through the plan.
    list(JOIN job_macos-package "\n" package)
    foreach(part IN ITEMS "version: \${{ needs.debian-plan.outputs.macos_qt }}"
                          "arch: \${{ needs.debian-plan.outputs.macos_qt_arch }}"
                          "TARGET: \${{ needs.debian-plan.outputs.macos_target }}"
                          "bash packaging/macos/build-package.sh")
        string(FIND "${package}" "${part}" at)
        if(at EQUAL -1)
            message(FATAL_ERROR "macos-package lacks '${part}'")
        endif()
    endforeach()
    list(JOIN job_debian-plan "\n" plan)
    foreach(key IN ITEMS build skipped qt qt_arch target)
        string(FIND "${plan}" "macos_${key}: \${{ steps.macos.outputs.macos_${key} }}" at)
        if(at EQUAL -1)
            message(FATAL_ERROR "debian-plan does not hand on macos_${key}")
        endif()
    endforeach()
    string(FIND "${plan}" "scripts/packaging/MacosPackage.cmake" at)
    if(at EQUAL -1)
        message(FATAL_ERROR "debian-plan does not run scripts/packaging/MacosPackage.cmake")
    endif()

else()
    message(FATAL_ERROR "unknown case '${CASE}'")
endif()
