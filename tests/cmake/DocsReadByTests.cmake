# SPDX-License-Identifier: GPL-3.0-or-later
# S042, decision 3: the files under docs/ that tests, benchmarks or fuzzers read are listed in
# tests/docs-read-by-tests.txt, one path per line. A pull request labelled version:doc must not
# change them (scripts/ci/DocsOnly.cmake), and the push filter of ci.yml names them, so that a change
# to such a file always runs the CI.
#
# hitokoto_docs_read_by_tests(<dir>) writes <dir>/hitokoto/test/docs_files.hpp: the helper
# test::docsFile<"name">() gives the path of docs/<name> in the source tree and refuses at compile
# time a name that is not on the list. The lint S042_TestsReadDocsOnlyThroughTheList makes sure no
# test reaches docs/ any other way; this file is left out of that lint.

set(HITOKOTO_DOCS_READ_BY_TESTS "${CMAKE_CURRENT_LIST_DIR}/../docs-read-by-tests.txt")

function(hitokoto_docs_read_by_tests dir)
    get_filename_component(list_file "${HITOKOTO_DOCS_READ_BY_TESTS}" ABSOLUTE)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${list_file}")
    file(STRINGS "${list_file}" entries)
    set(names "")
    foreach(entry IN LISTS entries)
        string(STRIP "${entry}" entry)
        if("${entry}" STREQUAL "")
            continue()
        endif()
        if(NOT entry MATCHES "^docs/([^/].*)$")
            message(FATAL_ERROR "${list_file}: '${entry}' is not a path under docs/")
        endif()
        set(name "${CMAKE_MATCH_1}")
        if(NOT EXISTS "${PROJECT_SOURCE_DIR}/${entry}")
            message(FATAL_ERROR "${list_file}: '${entry}' does not exist")
        endif()
        list(APPEND names "    \"${name}\",\n")
    endforeach()
    list(LENGTH names count)
    list(JOIN names "" names)
    file(CONFIGURE OUTPUT "${dir}/hitokoto/test/docs_files.hpp" @ONLY CONTENT [=[
// SPDX-License-Identifier: GPL-3.0-or-later
// Generated by tests/cmake/DocsReadByTests.cmake from tests/docs-read-by-tests.txt (S042).
#pragma once

#include <algorithm>
#include <array>
#include <cstddef>
#include <string>
#include <string_view>

namespace test {

/// The name of a document under docs/, as a template argument.
template <std::size_t N>
struct DocsName {
    // Not explicit: the literal in test::docsFile<"name">() converts to it.
    consteval DocsName(const char (&name)[N]) { std::copy_n(name, N, chars.begin()); }
    [[nodiscard]] constexpr std::string_view view() const { return {chars.data(), N - 1}; }
    std::array<char, N> chars{};
};

/// The documents tests may read, from tests/docs-read-by-tests.txt.
inline constexpr std::array<std::string_view, @count@> kDocsReadByTests{
@names@};

consteval bool isReadByTests(std::string_view name) {
    return std::find(kDocsReadByTests.begin(), kDocsReadByTests.end(), name) != kDocsReadByTests.end();
}

/// The path of docs/<Name> in the source tree; only for documents on tests/docs-read-by-tests.txt.
template <DocsName Name>
std::string docsFile() {
    static_assert(isReadByTests(Name.view()),
                  "S042: this document is not on tests/docs-read-by-tests.txt; add it there, and to the "
                  "push filter of ci.yml");
    return std::string("@PROJECT_SOURCE_DIR@/docs/") + std::string(Name.view());
}

}  // namespace test
]=])
endfunction()
