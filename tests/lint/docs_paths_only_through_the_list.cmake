# S042, decision 3: tests, benchmarks and fuzzers reach a file under docs/ only through the helper
# that tests/cmake/DocsReadByTests.cmake generates from tests/docs-read-by-tests.txt. A pull
# request labelled version:doc skips the build when it changes only files under docs/ that are not
# on that list; a test that read another document directly would no longer run when it changes.
#
# Reads the C++ and CMake files under SCAN_DIRS and fails on every line that holds "docs/" outside
# a comment: string literals (raw ones included), unquoted CMake arguments, relative paths and
# file(GLOB ...) alike. Text that only mentions such a path is allowed by the marker S042-mention
# in a comment on its line; the lines of a raw string literal, which cannot hold a comment, by the
# marker on the line where the raw string begins or on the line before it.
#   -DSCAN_DIRS=<dir>|<dir>...    directories to read, recursively
#   -DEXCLUDE=<path>|<path>...    files or directories to leave out (the helper, lint samples)
# Prints each finding and "docs-paths-lint: <n> findings"; fails if there is one.
cmake_minimum_required(VERSION 3.25)

if(NOT DEFINED SCAN_DIRS OR "${SCAN_DIRS}" STREQUAL "")
    message(FATAL_ERROR "SCAN_DIRS not set")
endif()

set(marker "S042-mention")
# A string literal of C++ or CMake, escapes included.
set(string_literal "\"(\\\\.|[^\"\\\\])*\"")
# A character literal of C++ ('"' would otherwise start a string).
set(char_literal "'(\\\\.|[^'\\\\])+'")

string(REPLACE "|" ";" dirs "${SCAN_DIRS}")
string(REPLACE "|" ";" excluded "${EXCLUDE}")
set(excluded_real "")
foreach(path IN LISTS excluded)
    get_filename_component(real "${path}" REALPATH)
    list(APPEND excluded_real "${real}")
endforeach()

set(sources "")
foreach(dir IN LISTS dirs)
    file(GLOB_RECURSE found "${dir}/*.cpp" "${dir}/*.hpp" "${dir}/*.h" "${dir}/*.cmake"
         "${dir}/CMakeLists.txt")
    list(APPEND sources ${found})
endforeach()
list(SORT sources)

# Whether <real> is one of the excluded files or lies in one of the excluded directories.
function(is_excluded real out)
    set(result FALSE)
    foreach(path IN LISTS excluded_real)
        if(real STREQUAL path)
            set(result TRUE)
        else()
            string(FIND "${real}" "${path}/" at)
            if(at EQUAL 0)
                set(result TRUE)
            endif()
        endif()
    endforeach()
    set(${out} ${result} PARENT_SCOPE)
endfunction()

# The part of <line> that is code, not comment, with its string literals: sets <out_code> to the
# code with every literal replaced by @STR@ and <out_strings> to the literals in that part, in
# order.
function(code_and_strings line comment out_code out_strings)
    set(work "${line}")
    if(comment STREQUAL "//")
        string(REGEX REPLACE "${char_literal}" "@CHR@" work "${work}")
    endif()
    string(REGEX MATCHALL "${string_literal}" literals "${work}")
    string(REGEX REPLACE "${string_literal}" "@STR@" code "${work}")
    string(FIND "${code}" "${comment}" at)
    if(NOT at EQUAL -1)
        string(SUBSTRING "${code}" 0 ${at} code)
    endif()
    # The literals before the comment: as many as the code part still holds.
    string(REGEX MATCHALL "@STR@" kept "${code}")
    list(LENGTH kept count)
    set(strings "")
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(i RANGE ${last})
            list(GET literals ${i} literal)
            list(APPEND strings "${literal}")
        endforeach()
    endif()
    set(${out_code} "${code}" PARENT_SCOPE)
    set(${out_strings} "${strings}" PARENT_SCOPE)
endfunction()

set(findings 0)
set(report "")
foreach(src IN LISTS sources)
    get_filename_component(real "${src}" REALPATH)
    is_excluded("${real}" skip)
    if(skip)
        continue()
    endif()
    file(READ "${src}" text)
    string(FIND "${text}" "docs/" any)
    if(any EQUAL -1)
        continue()
    endif()
    if(src MATCHES "\\.(cmake|txt)$")
        set(comment "#")
    else()
        set(comment "//")
    endif()
    # One list item per line; characters that break CMake lists are stood in for.
    string(REPLACE "\r" "" text "${text}")
    string(REPLACE ";" "@SC@" text "${text}")
    string(REPLACE "[" "@LB@" text "${text}")
    string(REPLACE "]" "@RB@" text "${text}")
    string(REPLACE "\n" ";" lines "${text}")
    set(lineno 0)
    set(raw_end "")       # the closing sequence of the raw string literal the line is in, if any
    set(raw_marked FALSE) # whether that raw string carries the marker
    set(previous_marked FALSE)
    foreach(line IN LISTS lines)
        math(EXPR lineno "${lineno} + 1")
        string(FIND "${line}" "${marker}" has_marker)
        set(marked FALSE)
        if(NOT has_marker EQUAL -1)
            set(marked TRUE)
        endif()
        set(found FALSE)
        if(NOT "${raw_end}" STREQUAL "")
            # Inside a raw string: every line is string content up to the closing sequence.
            string(FIND "${line}" "${raw_end}" close)
            set(content "${line}")
            if(NOT close EQUAL -1)
                string(SUBSTRING "${line}" 0 ${close} content)
                set(raw_end "")
            endif()
            string(FIND "${content}" "docs/" at)
            if(NOT at EQUAL -1 AND NOT raw_marked)
                set(found TRUE)
            endif()
        else()
            string(STRIP "${line}" stripped)
            set(whole_comment FALSE)
            if(comment STREQUAL "//" AND stripped MATCHES "^(//|/\\*|\\*)")
                set(whole_comment TRUE)
            elseif(comment STREQUAL "#" AND stripped MATCHES "^#")
                set(whole_comment TRUE)
            endif()
            if(comment STREQUAL "//" AND line MATCHES "R\"([^ ()\\\\\"]*)\\(")
                # A raw string literal begins; it continues on the next lines unless it closes here.
                set(delimiter "${CMAKE_MATCH_1}")
                string(FIND "${line}" "R\"${delimiter}(" open)
                string(SUBSTRING "${line}" ${open} -1 rest)
                string(FIND "${rest}" ")${delimiter}\"" close)
                if(close EQUAL -1)
                    set(raw_end ")${delimiter}\"")
                    set(raw_marked FALSE)
                    if(marked OR previous_marked)
                        set(raw_marked TRUE)
                    endif()
                    string(FIND "${rest}" "docs/" at)
                    if(NOT at EQUAL -1 AND NOT raw_marked)
                        set(found TRUE)
                    endif()
                    string(SUBSTRING "${line}" 0 ${open} line)
                endif()
            endif()
            string(FIND "${line}" "docs/" at)
            if(NOT whole_comment AND NOT marked AND NOT at EQUAL -1)
                code_and_strings("${line}" "${comment}" code strings)
                string(FIND "${code}" "docs/" in_code)
                if(NOT in_code EQUAL -1)
                    set(found TRUE)
                endif()
                foreach(literal IN LISTS strings)
                    string(FIND "${literal}" "docs/" in_literal)
                    if(NOT in_literal EQUAL -1)
                        set(found TRUE)
                    endif()
                endforeach()
            endif()
        endif()
        if(found)
            math(EXPR findings "${findings} + 1")
            string(REPLACE "@SC@" ";" shown "${line}")
            string(REPLACE "@LB@" "[" shown "${shown}")
            string(REPLACE "@RB@" "]" shown "${shown}")
            string(STRIP "${shown}" shown)
            string(APPEND report "\n  ${src}:${lineno}: ${shown}")
        endif()
        set(previous_marked ${marked})
    endforeach()
endforeach()

message(STATUS "docs-paths-lint: ${findings} findings")
if(findings GREATER 0)
    message(FATAL_ERROR
        "Tests, benchmarks and fuzzers reach files under docs/ only through test::docsFile, for "
        "files on tests/docs-read-by-tests.txt (S042). A line that only mentions such a path takes "
        "the marker ${marker} in a comment:${report}")
endif()
