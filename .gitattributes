# Normalise text files in the repository, check out with native line endings.
* text=auto
*.png binary
*.bmp binary
# Test fixtures must stay byte-exact (CRLF, BOM, invalid UTF-8 on purpose).
tests/fixtures/** -text
# S031: clipboard samples stay byte-exact as Qt delivers them.
tests/data/s031/samples/** -text
# S034: the Arch Linux recipe goes to the AUR byte for byte, and the PKGBUILD pins the checksum of
# the desktop entry.
packaging/archlinux/** text eol=lf
# S036: the Debian recipe holds shell scripts run with bash, also from a checkout on Windows.
packaging/debian/** text eol=lf
